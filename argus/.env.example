# FastAPI Settings
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Anthropic API
ANTHROPIC_API_KEY=
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
CLAUDE_MODEL=
LLM_MAX_CALLS=12
LLM_MAX_RPM=3
# Database
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus_secret
POSTGRES_DB=argus
DATABASE_URL=postgresql+asyncpg://argus:argus_secret@localhost:5432/argus

# Authentication
JWT_SECRET=replace_with_64_char_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development
ENVIRONMENT=development
LOG_LEVEL=INFO
DEV_MODE=false

# Fairness & Drift Thresholds
DEMOGRAPHIC_PARITY_WARNING=0.05
DEMOGRAPHIC_PARITY_CRITICAL=0.10
EQUALIZED_ODDS_WARNING=0.05
EQUALIZED_ODDS_CRITICAL=0.10
PSI_INFO=0.10
PSI_WARNING=0.20
PSI_CRITICAL=0.25
CALIBRATION_WARNING=0.10
CALIBRATION_CRITICAL=0.15

# Audit & Policies
AUDIT_OUTPUT_DIR=audit_outputs
UPDATE_DIR=policies/updates

# Monitoring
SLACK_WEBHOOK_URL=
PROMETHEUS_ENABLED=true

# Frontend CORS
FRONTEND_URLS=http://localhost:3000,http://localhost:5173

# RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_COLLECTION_NAME=regulations
